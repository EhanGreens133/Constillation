# ---------------------------------------------------------------------------
# Constellation configuration
#
# Nothing in this file is required for the archive to be readable. If every
# service below is unreachable, capture, search, reading and export still work.
# ---------------------------------------------------------------------------

# --- Auth (single user; there is no second account, ever) ------------------
# Any long random string. Rotating it logs you out. Required in production.
AUTH_SECRET=change-me-to-32-plus-random-bytes
# Your sign-in password, as a scrypt hash. Set it with:  npm run set-password
# (never store the password itself here). Colons, not "$", because Next.js
# expands $NAME references when it reads this file.
AUTH_PASSWORD_HASH=
# Alternative for hosts where running a script is awkward: the password in
# plain text. Works, but it sits readable in configuration - prefer the hash.
AUTH_PASSWORD=
# Where the magic link is sent. "console" writes it to the server log and to
# .data/magic-link.txt (fine for a self-hosted single-user box).
# "webhook" POSTs {url} to MAGIC_LINK_WEBHOOK (e.g. an ntfy/Slack/email relay).
MAGIC_LINK_DELIVERY=console
MAGIC_LINK_WEBHOOK=
# Optional: only this address may request a link. Blank = any request works
# (still safe-ish: the link only ever goes to your own console/webhook).
AUTHOR_EMAIL=
# Public origin, used to build the magic link.
APP_ORIGIN=http://localhost:3000

# --- Storage ---------------------------------------------------------------
# MongoDB Atlas connection string. If unset, Constellation falls back to a
# local JSON file store under .data/ so the app runs with no services at all.
MONGODB_URI=
MONGODB_DB=constellation
# Names of the Atlas indexes, if you created them (see npm run indexes).
# Without these, search falls back to an in-process lexical scan and
# relatedness falls back to TF-IDF. Both are correct, just slower.
ATLAS_SEARCH_INDEX=entries_text
ATLAS_VECTOR_INDEX=entries_vector
# Local JSON store location when MONGODB_URI is unset.
DATA_DIR=.data

# --- OpenAI ----------------------------------------------------------------
# One key covers both uses below. Both are optional: with no key at all, the
# naming pass proposes the opening words of each entry verbatim, and
# relatedness falls back to TF-IDF. Capture, search, reading and export never
# touch this.
OPENAI_API_KEY=

# --- Suggestions (naming and filing pass) ----------------------------------
# Used only on the suggest screen, only when you press the button, and it
# writes nothing on its own. Any model with structured-output support works.
SUGGEST_MODEL=gpt-5

# --- Embeddings (write time only, never read time) -------------------------
# Provider: openai | azure-openai | voyage | none
EMBEDDING_PROVIDER=openai
# Leave blank to use OPENAI_API_KEY above.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-* accept a shorter vector than their native size. This must
# match the numDimensions in your Atlas vector index.
EMBEDDING_DIMENSIONS=1536
# For an OpenAI-compatible gateway or Azure OpenAI, the full endpoint URL:
EMBEDDING_API_URL=
